FROM golang:1.21-alpine AS builder

RUN apk add --no-cache gcc musl-dev sqlite-dev

WORKDIR /app

COPY admin-app/go.mod admin-app/go.sum* ./
RUN go mod download

COPY admin-app/ ./

RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o qr-tracker-admin main.go

FROM alpine:latest

RUN apk add --no-cache ca-certificates sqlite-libs

WORKDIR /app

COPY --from=builder /app/qr-tracker-admin .

EXPOSE 9090

ENV PORT=9090
ENV DB_PATH=/data/qr-tracker.db

CMD ["./qr-tracker-admin"]
